@dataclass
class Capability:
    id: int
    name: str
    domain: str
    description: str
    enabled: bool = True
    requires_approval: bool = False
    handler: str | None = None


class GairusCapabilityMatrix:
    """
    MATRICE CENTRALE DES 200 CAPACITÉS DE GAÏRUS.

    Cette couche ne remplace aucun moteur existant.
    Elle donne à Gaïrus une carte unique de ses capacités,
    leurs permissions et leurs points d'intégration.

    Les capacités réelles sont exécutées par les connecteurs,
    outils, agents, APIs et moteurs déjà présents dans Gaïrus.
    """

    def __init__(self, runtime=None):
        self.runtime = runtime
        self.root = ROOT
        self.db_path = DB_PATH
        self.handlers: dict[str, Callable] = {}
        self.capabilities: dict[int, Capability] = {}

        self._init_database()
        self._build_matrix()
        self._bind_runtime()

    # =========================================================
    # DATABASE
    # =========================================================

    def _connect(self):
        conn = sqlite3.connect(
            str(self.db_path),
            check_same_thread=False,
        )
        conn.row_factory = sqlite3.Row
        return conn

    def _init_database(self):
        conn = self._connect()

        try:
            conn.execute(
                """
                CREATE TABLE IF NOT EXISTS capability_runs (
                    id TEXT PRIMARY KEY,
                    capability_id INTEGER NOT NULL,
                    status TEXT NOT NULL,
                    actor TEXT,
                    input_data TEXT,
                    output_data TEXT,
                    error TEXT,
                    created_at TEXT NOT NULL,
                    finished_at TEXT
                )
                """
            )

            conn.execute(
                """
                CREATE TABLE IF NOT EXISTS capability_settings (
                    capability_id INTEGER PRIMARY KEY,
                    enabled INTEGER NOT NULL DEFAULT 1,
                    requires_approval INTEGER NOT NULL DEFAULT 0,
                    updated_at TEXT NOT NULL
                )
                """
            )

            conn.commit()

        finally:
            conn.close()

